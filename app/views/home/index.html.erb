<%# Header %>
<header class="flex justify-center w-full px-4 pt-8">
  <div class="w-full max-w-3xl bg-white/10 backdrop-blur-xl border border-white/10 p-8 rounded-2xl text-center shadow-xl">
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-indigo-400">
      RubyFish
    </h1>
    <p class="text-slate-300 mt-3 text-lg">
      Visualise and store Redfish JSON files with ease
    </p>
  </div>
</header>
<%# Page buttons %>
<div class="flex flex-col md:flex-row justify-center items-stretch gap-6 px-4 py-8">
  <%= link_to cabinets_path,
      class: "group w-full max-w-sm bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl p-8 text-center shadow-xl transition-all duration-300 hover:bg-white/20 hover:-translate-y-1 hover:shadow-2xl" do %>
    <div class="flex justify-center mb-4">
      <div class="p-4 rounded-full bg-indigo-500/20 group-hover:bg-indigo-500/30 transition">
        <%= lucide_icon('server', class: "w-10 h-10 stroke-2 text-indigo-400") %>
      </div>
    </div>
    <h2 class="text-4xl font-bold text-indigo-400">
      Racks
    </h2>
    <p class="text-slate-300 mt-2">
      Manage rack layouts and hardware
    </p>
    <%= lucide_icon(
      'arrow-up-right',
      class: "w-6 h-6 mx-auto mt-5 text-slate-400 group-hover:text-indigo-400 transition"
    ) %>
  <% end %>
  <%= link_to servers_path,
      class: "group w-full max-w-sm bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl p-8 text-center shadow-xl transition-all duration-300 hover:bg-white/20 hover:-translate-y-1 hover:shadow-2xl" do %>
    <div class="flex justify-center mb-4">
      <div class="p-4 rounded-full bg-indigo-500/20 group-hover:bg-indigo-500/30 transition">
        <%= lucide_icon('server', class: "w-10 h-10 stroke-2 text-indigo-400") %>
      </div>
    </div>
    <h2 class="text-4xl font-bold text-indigo-400">
      Servers
    </h2>
    <p class="text-slate-300 mt-2">
      Manage server inventory and details
    </p>
    <%= lucide_icon(
      'arrow-up-right',
      class: "w-6 h-6 mx-auto mt-5 text-slate-400 group-hover:text-indigo-400 transition"
    ) %>
  <% end %>
</div>
<%# Header %>
<header class="flex justify-center w-full">
  <div class="container bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg min-w-24 max-w-100 text-center shadow-lg">
    <h1 class="text-indigo-500 text-5xl">RubyFish</h1>
    <p class="text-slate-400 pt-2">This tool is used to visualise and store redfish json files</p>
  </div>
</header>
<%# Page buttons %>
<div class="flex flex-col md:flex-row justify-center pt-4 pb-4 w-full gap-4">
  <%= link_to cabinets_path, class: "container hover:text-slate-400 self-center bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg min-w-24 max-w-100 text-center shadow-lg hover:bg-white/20 transition" do %>
    <h1 class="text-indigo-500 text-5xl">Racks</h1>
    <p class="text-slate-400 pt-2">Manage racks</p>
    <%= lucide_icon('square-arrow-out-up-right', class: "cursor-pointer stroke-3 m-auto mt-2") %>
  <% end %>
  <%= link_to servers_path, class: "container hover:text-slate-400 self-center bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg min-w-24 max-w-100 text-center shadow-lg hover:bg-white/20 transition" do %>
    <h1 class="text-indigo-500 text-5xl">Servers</h1>
    <p class="text-slate-400 pt-2">Manage servers</p>
    <%= lucide_icon('square-arrow-out-up-right', class: "cursor-pointer stroke-3 m-auto mt-2") %>
  <% end %>
</div>
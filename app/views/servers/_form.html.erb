<div class="flex justify-center px-4 py-8">
  <div class="w-full max-w-3xl bg-white/10 backdrop-blur-xl border border-white/10 p-6 rounded-2xl shadow-xl">
    <%= form_with model: server, class: "flex flex-col gap-5" do |form| %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :file, "JSON File", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.file_field :file,
            class: "w-full sm:w-2/3 text-slate-300 file:bg-indigo-600 file:text-white file:border-0 file:rounded-lg file:px-4 file:py-2 hover:file:bg-indigo-500 transition" %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :slot, "Slot", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.number_field :slot,
            min: 1,
            value: server.slot,
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :cabinet_id, "Rack", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.select :cabinet_id,
            options_from_collection_for_select(@cabinets, "id", "name", server.cabinet_id),
            { include_blank: "Select Rack" },
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer" %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :u_position, "U Position", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.number_field :u_position,
            min: 1,
            value: server.u_position,
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-start gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :notes, "Notes", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.text_area :notes,
            value: server.notes,
            rows: 4,
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div class="flex justify-center gap-4 pt-4">
        <%= form.submit class: "px-5 py-2 rounded-xl bg-emerald-700 border border-emerald-500 transition hover:bg-emerald-500 hover:-translate-y-0.5 cursor-pointer" %>
        <%= link_to "Cancel",
            :back,
            class: "px-5 py-2 rounded-xl bg-slate-700 border border-slate-500 transition hover:bg-slate-600 hover:-translate-y-0.5 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
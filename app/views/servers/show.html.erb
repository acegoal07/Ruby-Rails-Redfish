<%# Header %>
<header class="flex justify-center w-full px-4 pt-8">
  <div class="w-full max-w-4xl bg-white/10 backdrop-blur-xl border border-white/10 p-8 rounded-2xl text-center shadow-xl">
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-indigo-400">
      <%= @server_data.system_name %>
    </h1>
    <p class="text-slate-300 mt-3 break-all">
      <%= @server_data.system_uuid %>
    </p>
    <div class="flex flex-col sm:flex-row justify-between gap-4 mt-6">
      <%= link_to servers_path,
          class: "px-5 py-2 rounded-xl bg-slate-700 border border-slate-500 transition hover:bg-slate-600 hover:-translate-y-0.5" do %>
        Back
      <% end %>
      <div class="flex justify-center sm:justify-end gap-3">
        <%= link_to edit_server_path(@server),
            class: "px-5 py-2 rounded-xl bg-emerald-700 border border-emerald-500 transition hover:bg-emerald-500 hover:-translate-y-0.5" do %>
          Edit
        <% end %>
        <%= button_to "Delete",
            @server,
            class: "px-5 py-2 rounded-xl bg-red-700 border border-red-500 transition hover:bg-red-500 hover:-translate-y-0.5",
            method: :delete,
            data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </div>
  </div>
</header>
<%# Pagination %>
<div class="flex justify-between max-w-4xl mx-auto px-4 pt-6">
  <% if params[:entry] != '0' %>
    <%= link_to server_path(@server, entry: params[:entry].nil? ? 1 : params[:entry].to_i - 1),
        class: "p-3 rounded-xl bg-slate-700 border border-slate-500 transition hover:bg-slate-600" do %>
      <%= lucide_icon('arrow-left', class: "w-5 h-5") %>
    <% end %>
  <% else %>
    <div></div>
  <% end %>
  <% if @history_size > 0 && @history_size.to_s != params[:entry] %>
    <%= link_to server_path(@server, entry: params[:entry].nil? ? 2 : params[:entry].to_i + 1),
        class: "p-3 rounded-xl bg-slate-700 border border-slate-500 transition hover:bg-slate-600" do %>
      <%= lucide_icon('arrow-right', class: "w-5 h-5") %>
    <% end %>
  <% end %>
</div>
<%# Display Grid %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full px-4 py-6 max-w-7xl mx-auto">
  <%# System Info %>
  <div class="bg-white/10 backdrop-blur-xl border border-white/10 p-6 rounded-2xl shadow-xl h-min sticky top-10">
    <h2 class="text-3xl font-bold text-indigo-400 text-center mb-4">
      System Info
    </h2>
    <p class="text-slate-400 text-center mb-4">
      Last updated: <%= @server_data.updated_at %>
    </p>
    <div class="space-y-0">
      <% info = [
    ["Asset ID", (!@server_data.id.zero? && params[:entry] == '0') ? @server_data.id : nil],
    ["System Model", @server_data.system_model],
    ["Total Memory", @server_data.memory_total_gib ? "#{@server_data.memory_total_gib} GB" : nil],
    ["CPU Model", @server_data.cpu_model],
    ["CPU Count", @server_data.cpu_count],
    ["Core Count", @server_data.core_count],
    ["Logical Core Count", @server_data.logical_core_count],
    ["BIOS Version", @server_data.bios_version ? "v#{@server_data.bios_version}" : nil],
    ["Rack", @cabinet&.name],
    ["Slot", (!@server_data.slot.nil? && !@server_data.slot.zero?) ? @server_data.slot : nil],
    ["U Position", (!@server_data.u_position.nil? && !@server_data.u_position.empty?) ? @server_data.u_position : nil],
    ["Notes", (!@server_data.notes.nil? && !@server_data.notes.empty?) ? @server_data.notes : nil]
  ] %>
      <% info.each do |label, value| %>
        <% unless value.nil? || value.to_s.empty? %>
          <div class="grid grid-cols-2 gap-4 border-t border-slate-600/50 py-3">
            <p class="text-right text-slate-400"><%= label %>:</p>
            <p class="text-left text-slate-200 break-words"><%= value %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <%# Raw JSON %>
  <div class="bg-white/10 backdrop-blur-xl border border-white/10 p-6 rounded-2xl shadow-xl">
    <h2 class="text-3xl font-bold text-indigo-400 text-center mb-4">
      Raw JSON
    </h2>
    <div class="overflow-auto max-h-[800px] border border-slate-600 rounded-xl bg-slate-900/50 p-4">
      <pre class="text-left text-sm text-slate-300 whitespace-pre-wrap"><%= @json %></pre>
    </div>
  </div>
</div>
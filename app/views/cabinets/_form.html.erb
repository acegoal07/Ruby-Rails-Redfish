<div class="flex justify-center px-4 py-8">
  <div class="w-full max-w-3xl bg-white/10 backdrop-blur-xl border border-white/10 p-6 rounded-2xl shadow-xl">
    <%= form_with model: cabinet, class: "flex flex-col gap-5" do |form| %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :name, "Name", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.text_field :name,
            required: true,
            value: cabinet.name,
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 text-center transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :u_size, "U Size", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.number_field :u_size,
            min: 1,
            value: cabinet.u_size,
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 text-center transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-start gap-3 border-b border-slate-600/50 pb-4">
        <%= form.label :notes, "Notes", class: "sm:w-1/3 text-slate-300 font-medium" %>
        <%= form.text_area :notes,
            value: cabinet.notes,
            rows: 4,
            class: "w-full sm:w-2/3 border border-slate-500 rounded-xl bg-slate-800/80 p-2 text-slate-200 transition hover:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div class="flex justify-center gap-4 pt-4">
        <%= form.submit class: "px-5 py-2 rounded-xl bg-emerald-700 border border-emerald-500 transition hover:bg-emerald-500 hover:-translate-y-0.5 cursor-pointer" %>
        <%= link_to "Cancel",
            :back,
            class: "px-5 py-2 rounded-xl bg-slate-700 border border-slate-500 transition hover:bg-slate-600 hover:-translate-y-0.5 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
<%# Header %>
<header class="flex justify-center w-full">
  <div class="container bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg min-w-24 max-w-100 text-center shadow-lg">
    <h1 class="text-indigo-500 text-5xl"><%= @cabinet.name %></h1>
    <div class="flex flex-inline pt-2 pb-2">
      <%= link_to "Back", cabinets_path, class: 'bg-slate-700 rounded rounded-lg p-2.75 border border-slate-500 transition hover:bg-slate-500 hover:border-slate-700 cursor-pointer' %>
      <div class="flex justify-end w-full gap-4">
        <%= link_to "Edit", edit_cabinet_path(@cabinet), class: 'bg-emerald-700 rounded rounded-lg p-2.75 border border-emerald-500 transition hover:bg-emerald-500 hover:border-emerald-700 cursor-pointer' %>
        <%= button_to "Delete", @cabinet, class: 'bg-red-700 rounded rounded-lg p-2.75 border border-red-500 transition hover:bg-red-500 hover:border-red-700 cursor-pointer', method: :delete, data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </div>
  </div>
</header>
<%# Gathered Info %>
<header class="flex justify-center w-full pt-4 pb-4">
  <div class="bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg text-center shadow-lg max-w-200">
    <p class="text-slate-400 pb-2">Last updated: <%= @cabinet.updated_at%></p>
    <% if !@cabinet.u_size.nil? && !@cabinet.u_size.zero? %>
      <div class="grid grid-cols-2 border-t border-slate-500 pt-2 gap-3">
        <p class="text-right text-slate-400">U Size:</p>
        <p class="text-left"><%= @cabinet.u_size %></p>
      </div>
    <% end %>
    <% if !@cabinet.notes.nil? && !@cabinet.notes.empty? %>
      <div class="grid grid-cols-2 border-t border-slate-500 pt-2 gap-3">
        <p class="text-right text-slate-400">Notes:</p>
        <p class="text-left"><%= @cabinet.notes %></p>
      </div>
    <% end %>
  </div>
</div>

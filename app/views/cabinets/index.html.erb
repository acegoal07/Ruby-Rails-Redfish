<%# Header %>
<header class="flex justify-center w-full px-4 pt-8">
  <div class="w-full max-w-3xl bg-white/10 backdrop-blur-xl border border-white/10 p-8 rounded-2xl text-center shadow-xl">
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-indigo-400">
      Racks
    </h1>
    <p class="text-slate-300 mt-3 text-lg">
      View, edit, delete, or add new racks
    </p>
    <div class="flex justify-center mt-5">
      <%= link_to '/',
          class: "group flex items-center justify-center p-3 rounded-xl bg-slate-700/80 border border-slate-500 transition hover:bg-slate-600 hover:-translate-y-0.5" do %>
        <%= lucide_icon(
          'arrow-left',
          class: "w-5 h-5 stroke-3 text-slate-200 group-hover:text-white transition"
        ) %>
      <% end %>
    </div>
  </div>
</header>
<%# Stored racks %>
<div class="flex justify-center w-full px-4 py-8">
  <div class="w-full max-w-3xl bg-white/10 backdrop-blur-xl border border-white/10 p-6 rounded-2xl shadow-xl">
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-2xl font-semibold text-slate-200">
        Rack List
      </h2>
      <%= link_to new_cabinet_path,
          class: "group flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600/80 border border-indigo-400 transition hover:bg-indigo-500 hover:-translate-y-0.5" do %>
        <%= lucide_icon(
          'plus',
          class: "w-5 h-5 stroke-3"
        ) %>
        <span class="hidden sm:inline">
          Add Rack
        </span>
      <% end %>
    </div>
    <div id="racks">
      <% if @cabinets.any? %>
        <ul class="divide-y divide-slate-600/50">
          <% @cabinets.each do |cabinet| %>
            <li class="flex items-center gap-4 py-4 group">
              <%= link_to cabinet_path(cabinet.id),
                  class: "flex items-center gap-3 flex-1 hover:text-indigo-400 transition" do %>
                <div class="p-3 rounded-xl bg-slate-800/70 group-hover:bg-indigo-500/20 transition">
                  <%= lucide_icon(
                    'server',
                    class: "w-6 h-6 stroke-2 text-indigo-400"
                  ) %>
                </div>
                <span class="text-lg font-medium text-slate-200">
                  <%= cabinet.name %>
                </span>
              <% end %>
              <div class="flex gap-2">
                <%= link_to edit_cabinet_path(cabinet),
                    class: "p-2.5 rounded-xl bg-emerald-700/80 border border-emerald-500 transition hover:bg-emerald-500 hover:-translate-y-0.5" do %>
                  <%= lucide_icon(
                    'pen',
                    class: "w-5 h-5 stroke-2"
                  ) %>
                <% end %>
                <%= button_to cabinet,
                    class: "p-2.5 rounded-xl bg-red-700/80 border border-red-500 transition hover:bg-red-500 hover:-translate-y-0.5 cursor-pointer",
                    method: :delete,
                    data: { turbo_confirm: "Are you sure?" } do %>
                  <%= lucide_icon(
                    'trash-2',
                    class: "w-5 h-5 stroke-2"
                  ) %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-10 text-slate-400">
          <%= lucide_icon(
            'server-off',
            class: "w-12 h-12 mx-auto mb-3 opacity-60"
          ) %>
          <p>No racks added yet</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
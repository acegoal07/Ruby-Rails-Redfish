<%# Header %>
<header class="flex justify-center w-full">
  <div class="container bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg min-w-24 max-w-100 text-center shadow-lg">
    <h1 class="text-indigo-500 text-5xl">Racks</h1>
    <p class="text-slate-400 pt-2">On this page you can view, edit, delete or add new Racks</p>
    <div class="flex justify-center pt-2">
      <%= link_to '/', class: 'bg-slate-700 rounded rounded-lg p-2.75 border border-slate-500 transition hover:bg-slate-500 hover:border-slate-700 cursor-pointer' do %>
        <%= lucide_icon('undo-2', class: "hover:text-slate-400 transition cursor-pointer stroke-3") %>
      <% end %>    </div>
  </div>
</header>
<%# Stored servers %>
<div class="flex justify-center w-full pt-4">
  <div class="container bg-white/10 backdrop-blur-lg p-4 rounded rounded-lg min-w-24 max-w-100 text-center shadow-lg">
    <div id="servers">
      <div class="flex justify-center">
        <%= link_to new_cabinet_path do %>
          <%= lucide_icon('circle-plus', class: "hover:text-slate-400 transition cursor-pointer stroke-3") %>
        <% end %>
      </div>
      <ul class="display-list">
        <% @cabinets.each do |cabinet| %>
          <li class="flex gap-2 border-t border-slate-500 p-3 [&:first-child]:mt-3 text-lg">
            <%= link_to cabinet_path(cabinet.id), class: 'flex gap-2 hover:text-slate-400 transition w-auto align-center justify-center flex-inline' do %>
              <%= lucide_icon('server', class: "h-auto stroke-3") %>
              <p class="self-center"><%= cabinet.name %></p>
            <% end %>
            <div class="flex flex-inline gap-2 ms-auto">
              <%= link_to edit_cabinet_path(cabinet), class: 'bg-emerald-700 rounded rounded-lg p-2.25 border border-emerald-500 transition hover:bg-emerald-500 hover:border-emerald-700 cursor-pointer' do %>
                <%= lucide_icon('square-pen', class: "stroke-2") %>
              <% end %>
              <%= button_to cabinet, class: 'bg-red-700 rounded rounded-lg p-2.25 border border-red-500 transition hover:bg-red-500 hover:border-red-700 cursor-pointer', method: :delete, data: { turbo_confirm: "Are you sure?" } do %>
                <%= lucide_icon('trash', class: "stroke-2") %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>